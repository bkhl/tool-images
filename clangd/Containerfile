FROM docker.io/library/debian:13-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS download

# renovate: datasource=github-releases depName=clangd/clangd
ARG CLANGD_VERSION=23.1.0

ADD https://github.com/clangd/clangd/releases/download/${CLANGD_VERSION}/clangd-linux-${CLANGD_VERSION}.zip /tmp/clangd.zip

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && unzip -q /tmp/clangd.zip -d /tmp \
    && mv "/tmp/clangd_${CLANGD_VERSION}" /opt/clangd

FROM docker.io/library/debian:13-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=download /opt/clangd /opt/clangd

ENTRYPOINT ["/opt/clangd/bin/clangd"]
