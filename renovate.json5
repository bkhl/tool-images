{
  extends: [
    'config:recommended',
    'customManagers:dockerfileVersions',
    'docker:pinDigests',
  ],

  dependencyDashboard: false,

  'github-actions': {
    enabled: false,
  },

  // There are no PR checks, so automerge would otherwise never happen.
  ignoreTests: true,

  // Renovate only runs at 22:23 UTC, which is outside the default window of before 4am on Monday.
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'on monday',
    ],
  },

  // Keep go.sum and indirect requirements consistent after updates.
  postUpdateOptions: [
    'gomodTidy',
  ],

  packageRules: [
    // Go marks dependencies pulled in by "tool" directives as indirect, which
    // Renovate ignores by default.
    {
      matchManagers: [
        'gomod',
      ],
      matchDepNames: [
        'github.com/toba/go-template-lsp',
      ],
      enabled: true,
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'lockFileMaintenance',
      ],
      automerge: true,
    },
  ],
}
